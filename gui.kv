#:import Clock kivy.clock.Clock
#:import threading threading
#:import partial functools.partial
<MainScreen>:
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            source: 'images/background.png' 
    # Controls
    BoxLayout:
        cols: 3
        id: controls_box
        orientation: 'horizontal'
        pos: 15, 50
        rows: 5
        size: 602, 430
        size_hint: None, None
        spacing: 20
        BoxLayout:
            spacing: 20
            orientation: 'vertical'
            Button:
                background_normal: 'images/labels/display-label.png'
                background_down: 'images/labels/display-label.png'
                on_release: app.gesture.register('display')
                id: display_label
            PowerOnButton:
                background_normal: 'images/buttons/off/projectoron.png'
                background_down: 'images/buttons/on/projectoron.png'
                id: power
                group: 'power_buttons'
                on_state: self.start_projector() if (self.state == 'down' and app.manager.current == 'main') else print()
                state: 'down' if app.projector.power_state == True else 'normal'
            PowerOffButton:
                background_normal: 'images/buttons/off/projectoroff.png'
                background_down: 'images/buttons/on/projectoroff.png'
                id: power_off
                group: 'power_buttons'
                on_state: self.stop_projector() if (self.state == 'down' and app.manager.current == 'main') else print()
                state: 'down' if app.projector.power_state == False else 'normal'
            HuskyButton:
                background_normal: 'images/buttons/off/blank.png'
                background_down: 'images/buttons/on/blank.png'
                id: blank 
                on_state: app.controller.turn_on_blank() if (self.state == 'down') else app.controller.turn_off_blank()
                state: 'down' if app.image.blanked else 'normal'
            HuskyButton:
                background_normal: 'images/buttons/off/freeze.png'
                background_down: 'images/buttons/on/freeze.png'
                id: freeze
                on_state: app.controller.turn_on_freeze() if (self.state == 'down') else app.controller.turn_off_freeze()
                state: 'down' if app.image.frozen else 'normal'
        # Input
        BoxLayout:
            orientation: 'vertical'
            spacing: 20
            Button:
                background_normal: 'images/labels/input-label.png'
                background_down: 'images/labels/input-label.png'
                on_release: app.gesture.register('input')
                id: input_label
            InputButton:
                background_normal: 'images/buttons/off/podium.png'
                background_down: 'images/buttons/on/podium.png'
                id: podium
                group: 'input_buttons'
                on_state: self.select_input("podium") if (self.state == 'down') else print()
                state: 'down' if app.input.input == 0 else 'normal'
            InputButton:
                background_normal: 'images/buttons/off/usbc.png'
                background_down: 'images/buttons/on/usbc.png'
                id: usbc
                group: 'input_buttons'
                state: 'down' if app.input.input == 2 else 'normal'
                on_state: self.select_input("usbc") if (self.state == 'down') else print()
            InputButton:
                background_normal: 'images/buttons/off/hdmi.png'
                background_down: 'images/buttons/on/hdmi.png'
                id: hdmi
                group: 'input_buttons'
                state: 'down' if app.input.input == 1 else 'normal'
                on_state: self.select_input("hdmi") if (self.state == 'down') else print()
            InputButton:
                background_normal: 'images/buttons/off/vga.png'
                background_down: 'images/buttons/on/vga.png'
                id: vga
                group: 'input_buttons'
                state: 'down' if app.input.input == 3 else 'normal'
                on_state: self.select_input("vga") if (self.state == 'down') else print()
        # Audio
        BoxLayout:
            orientation: 'vertical'
            spacing: 40
            Button:
                background_normal: 'images/labels/audio-label.png'
                background_down: 'images/labels/audio-label.png'
                id: audio_label
                on_release: app.gesture.register('audio')
                size_hint: 1, 0.2
            Slider:
                background_vertical: 'images/slider/slider-background.png'
                background_width: 4
                cursor_height: 21
                cursor_image: 'images/slider/cursor.png'
                cursor_width: 21
                id: volume
                min: 0
                max: 100
                on_value: app.sound.set_volume(int(self.value))
                orientation: 'vertical'
                size_hint: 1, 0.6
                step: 1
                value: app.sound.volume
                value_track: True
                value_track_color: [0, 0, 0, 1]
            MuteButton:
                background_normal: 'images/buttons/off/mute.png'
                background_down: 'images/buttons/on/unmute.png'
                id: mute
                on_state: self.change_state(app)
                size_hint: 1, 0.2
                state: 'down' if app.sound.mute else 'normal'
<TestScreen>:
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            source: 'images/background.png'
    BoxLayout:
        orientation: 'vertical'
        pos: 15, 15
        size: 770, 450
        size_hint: None, None
        spacing: 10
        padding: 10
        canvas.before:
            Color:
                rgba: 1, 1, 1, 0.85
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 80
            spacing: 10
            Button:
                text: 'Projector On\n(raw)'
                halign: 'center'
                on_release: app.projector.test_enable()
            Button:
                text: 'Projector Off\n(raw)'
                halign: 'center'
                on_release: app.projector.test_disable()
            Button:
                text: 'Reset\nConnection'
                halign: 'center'
                on_release: app.projector.commander.reconnect()
            Button:
                text: 'Back'
                halign: 'center'
                on_release: root.exit_test_mode()
        Label:
            text: app.projector.commander.connection_status
            size_hint_y: None
            height: 24
            color: 0, 0, 0, 1
            font_size: '14sp'
        ScrollView:
            id: log_scroll
            do_scroll_x: False
            Label:
                id: log_lines_label
                text: '\n'.join(app.log_lines)
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: 'left'
                valign: 'top'
                color: 0, 0, 0, 1
                padding: 10, 10
                on_texture_size: log_scroll.scroll_y = 0